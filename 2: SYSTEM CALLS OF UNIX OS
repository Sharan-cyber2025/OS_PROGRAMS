## (a) FORK SYSTEM CALL

#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
int main(void) {
pid_t pid = fork();
if (pid < 0) { 
perror("fork"); 
return 1;    
}    
printf("THIS LINE IS EXECUTED BY BOTH PROCESSES\n"); 
if (pid == 0) {       
printf("I AM CHILD PROCESS AND MY ID IS %d\n", getpid()); 
printf("MY PARENT PROCESS ID IS %d\n", getppid());    
} 
else {
printf("I AM PARENT PROCESS AND MY ID IS %d\n", getpid());       
printf("MY PARENT PROCESS ID IS %d\n", getppid());
}     
return 0;
}

## (b) SYSTEM CALL WITH ARGUMENT

#include <stdio.h> 
#include <stdlib.h> 
#include <unistd.h> 
#include <sys/wait.h>
int main(void) {  
pid_t pid = fork();    
if (pid < 0) {      
perror("fork");      
return 1;   
}    
if (pid == 0) {   
printf("CHILD PROCESS IS IN PROGRESS\n");     
for (int i = 0; i < 5; i++)          
printf("THE CHILD PROCESSING VALUE IS: %d\n", i);
execlp("ls", "ls", (char *)NULL);    
perror("execlp");       
exit(EXIT_FAILURE);    
}   
printf("PARENT PROCESS IS WAITING\n");    
waitpid(pid, NULL, 0);    
printf("CHILD PROCESS COMPLETED ITS TASK\n");      
return 0; 
}

## (c) WORKING WITH DIRECTORY

#include <stdio.h>
#include <stdlib.h>
#include <dirent.h>
int main(int argc, char *argv[]) {  
if (argc != 2) {      
fprintf(stderr, "Usage: %s <directory>\n", argv[0]);     
return 1;   
}     
DIR *dir = opendir(argv[1]);    
if (dir == NULL) {     
perror("opendir");        
return 1;   
}      
printf("LISTING THE DIRECTORY CONTENT\n");  
printf("THE CURRENT DIRECTORY FILES ARE:\n");    
struct dirent *entry;  
while ((entry = readdir(dir)) != NULL)   
printf("%s\n", entry->d_name);    
closedir(dir);    
return 0;
}

## (d) STAT SYSTEM CALL

#include <stdio.h> 
#include <sys/stat.h>
int main(void) {   
struct stat sfile;    
if (stat("stat.c", &sfile) == -1) {  
perror("stat");     
return 1;  
}      
printf("file st_uid: %ld\n", (long)sfile.st_uid);    
printf("file st_gid: %ld\n", (long)sfile.st_gid);   
printf("file st_size: %ld\n", (long)sfile.st_size);  
printf("file st_blocks: %ld\n", (long)sfile.st_blocks);   
printf("file serialno: %ld\n", (long)sfile.st_ino);    
printf("file recent access time: %ld\n", (long)sfile.st_atime);   
printf("file permission change time: %ld\n", (long)sfile.st_ctime);  
printf("file recent modified time: %ld\n", (long)sfile.st_mtime);     
return 0;
}



